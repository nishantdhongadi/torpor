{
  "manifest_version": 3,
  "name": "Torpor",
  "version": "1.0.0",
  "description": "Keeps a large tab collection without keeping it in memory. Built for Zen Browser spaces.",
  "browser_specific_settings": {
    "gecko": {
      "id": "torpor@nishantdhongadi",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Torpor",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
